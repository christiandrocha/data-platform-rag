# data-platform-rag environment variables
# Copy this file to .env and fill real values. .env is gitignored.

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Anthropic API key for the generation LLM (Claude Sonnet)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

LLM_MODEL=claude-sonnet-4-6

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dpr:dpr_local_dev@localhost:5432/data_platform_rag

# ─── Retrieval configuration ─────────────────────────────────────────────────
HYBRID_TOP_K=20
RERANK_TOP_K=5
FALLBACK_THRESHOLD=0.35
HNSW_EF_SEARCH=40

# ─── Local models (no API cost) ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Langfuse (optional — LLM observability) ────────────────────────────────
# When LANGFUSE_ENABLED=false, all Langfuse calls are no-op.
# When true, keys are required. Free tier at https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Corpus sources (indexed offline, not runtime) ──────────────────────────
CORPUS_REPO_SNOWFLAKE=https://github.com/christiandrocha/sdd-kafka-snowflake-2
CORPUS_REPO_DATABRICKS=https://github.com/christiandrocha/sdd-kafka-databricks
